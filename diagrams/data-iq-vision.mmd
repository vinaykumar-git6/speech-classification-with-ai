    ADLSOUT --> INGEST --> BRONZE --> SILVER --> GOLD
    UC -.->|"governs"| INGEST
    UC -.->|"governs"| LAKEHOUSE
    DQ -.->|"validates"| LAKEHOUSE
    SILVER <--> MLSERVING

    GOLD --> AIBI
    GOLD --> POWERBI
    GOLD --> APPS
    SILVER --> ANALYSTS
    GOLD -->|"confidence and policy rules"| REVIEW
    REVIEW -->|"approved correction and feedback"| SILVER
    AIBI --> ACTIONS
    POWERBI --> ACTIONS
    APPS --> ACTIONS
    REVIEW --> ACTIONS