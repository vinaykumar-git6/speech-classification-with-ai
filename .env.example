# Copy to .env and fill in the values.
#
# .env is read by scripts/local_test.py only. The Azure Functions host
# (`func start`) reads local.settings.json instead, and the deployed app
# reads Azure App Settings. Keep the three in sync when you change endpoints.

# --- Microsoft Foundry ---
# These are the data-plane endpoints of the Foundry resource. The portal's
# project URL (.../api/projects/<project>) is for the AI Projects SDK and is
# not accepted by the Speech REST API or the OpenAI client used here.
SPEECH_ENDPOINT=https://<foundry-resource>.cognitiveservices.azure.com
AZURE_OPENAI_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/openai/v1
# Model deployment name, not the base model name.
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
SPEECH_API_VERSION=2025-10-15
SPEECH_TIMEOUT_SECONDS=600
# Optional. Leave unset to authenticate with `az login` / managed identity.
# SPEECH_API_KEY=

# --- Classification ---
CLASSIFICATION_CATEGORIES=complaint,cancellation,sales,service_request,fraud,other
DEFAULT_LOCALE=en-US

# --- Local folders ---
# scripts/local_test.py reads audio from here and writes result JSON here.
LOCAL_INPUT_DIR=samples/recordings
LOCAL_OUTPUT_DIR=samples/results

# --- Blob Storage (deployed pipeline only, unused by scripts/local_test.py) ---
# STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
# INPUT_CONTAINER=recordings
# OUTPUT_CONTAINER=results
